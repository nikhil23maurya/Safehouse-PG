generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  MOVED_OUT
}

enum InvoiceStatus {
  DUE
  PROCESSING
  PAID
  WAIVED
}

enum PaymentAttemptStatus {
  CREATED
  VERIFIED
  CAPTURED
  FAILED
}

enum PaymentSource {
  RAZORPAY
  MANUAL
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
  BANK_TRANSFER
  OTHER
}

model User {
  id                 String     @id @default(cuid())
  email              String?    @unique
  passwordHash       String?
  fullName           String
  role               UserRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  tokenVersion       Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  ownedProperties Property[] @relation("PropertyOwner")
  studentProfile  Student?
  platformMemberships PgMembership[]
  platformOrganisation PgOrganisation?
  platformAccount PgAccount?
  auditLogs       AuditLog[] @relation("AuditActor")
  deviceRegistrations DeviceRegistration[]
}

model Property {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User           @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  rooms         Room[]
  students      Student[]
  invoices      RentInvoice[]
  payments      Payment[]
  auditLogs     AuditLog[]
  rentRevisions RentRevision[]
  notificationCampaigns NotificationCampaign[]
  platformSetup PgPropertySetup?
  platformMemberships PgMembership[]
  platformInvitations PgInvitation[]

  @@index([ownerId])
}

// PGOne platform expansion: new identities/memberships supplement legacy actors.
// Existing financial tables, identifiers and values are retained.
model PgAccount {
  id String @id @default(cuid())
  firebaseUid String? @unique
  phoneE164 String? @unique
  legacyUserId String? @unique
  fullName String @default("")
  email String?
  emailVerified Boolean @default(false)
  status String @default("ACTIVE")
  tokenVersion Int @default(0)
  setupIntent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  legacyUser User? @relation(fields: [legacyUserId], references: [id], onDelete: Restrict)
  organisations PgOrganisation[]
  memberships PgMembership[]
}

model PgOrganisation {
  id String @id @default(cuid())
  ownerAccountId String
  legacyOwnerId String @unique
  name String
  legacyAccess Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner PgAccount @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)
  legacyOwner User @relation(fields: [legacyOwnerId], references: [id], onDelete: Restrict)
  memberships PgMembership[]
  properties PgPropertySetup[]
  invitations PgInvitation[]
  subscriptions PgSubscription[]
  merchant PgMerchantAccount?
  planOrders PgPlanOrder[]
  planReceipts PgPlanReceipt[]
  @@index([ownerAccountId])
}

model PgPropertySetup {
  propertyId String @id
  organisationId String
  city String @default("")
  approximateRooms Int?
  creationKey String @unique
  createdAt DateTime @default(now())
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  organisation PgOrganisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  @@index([organisationId])
}

model PgMembership {
  id String @id @default(cuid())
  accountId String
  organisationId String
  propertyId String
  role String
  actorUserId String?
  status String @default("ACTIVE")
  permissions String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account PgAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  organisation PgOrganisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@unique([accountId, propertyId, role])
  @@index([organisationId, status])
  @@index([actorUserId])
}

model PgInvitation {
  id String @id @default(cuid())
  organisationId String
  propertyId String
  role String
  phoneE164 String
  studentId String?
  permissions String[] @default([])
  tokenHash String @unique
  createdByAccountId String
  acceptedByAccountId String?
  status String @default("PENDING")
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  organisation PgOrganisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  @@index([organisationId, status])
}

model PgSubscription {
  id String @id @default(cuid())
  organisationId String
  current Boolean @default(true)
  provider String @default("RAZORPAY")
  providerSubscriptionId String? @unique
  creationReference String @unique
  status String @default("NOT_STARTED")
  amountPaise Int @default(24900)
  currency String @default("INR")
  periodStart DateTime?
  periodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organisation PgOrganisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  payments PgBillingPayment[]
}

model PgBillingPayment {
  id String @id @default(cuid())
  subscriptionId String
  providerInvoiceId String @unique
  providerPaymentId String @unique
  amountPaise Int
  taxPaise Int
  refundedPaise Int @default(0)
  currency String @default("INR")
  status String
  receiptNumber String
  paidAt DateTime
  periodStart DateTime
  periodEnd DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscription PgSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  @@index([subscriptionId, periodEnd])
}

model PgProviderEvent {
  id String @id @default(cuid())
  provider String
  eventKey String
  payloadHash String
  eventType String
  processedAt DateTime @default(now())
  @@unique([provider, eventKey])
}

// Owner-initiated monthly payments. Never create a recurring mandate.
model PgPlanOrder {
  id String @id @default(cuid())
  organisationId String
  requestKey String
  receiptReference String @unique
  providerOrderId String? @unique
  providerKeyId String
  amountPaise Int @default(24900)
  taxPaise Int
  currency String @default("INR")
  status String @default("CREATING")
  open Boolean @default(true)
  signatureVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organisation PgOrganisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  receipt PgPlanReceipt?
  @@unique([id, organisationId])
  @@unique([organisationId, requestKey])
  @@index([organisationId, open])
}

model PgPlanReceipt {
  id String @id @default(cuid())
  organisationId String
  orderId String @unique
  providerPaymentId String @unique
  receiptNumber String @unique
  amountPaise Int
  taxPaise Int
  refundedPaise Int @default(0)
  currency String @default("INR")
  status String @default("CAPTURED")
  paidAt DateTime
  periodStart DateTime
  periodEnd DateTime
  anchorDay Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organisation PgOrganisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  order PgPlanOrder @relation(fields: [orderId, organisationId], references: [id, organisationId], onDelete: Restrict)
  @@unique([orderId, organisationId])
  @@index([organisationId, periodEnd])
}

model PgMerchantAccount {
  id String @id @default(cuid())
  organisationId String @unique
  provider String @default("CASHFREE_EMBEDDED")
  providerAccountRef String? @unique
  status String @default("NOT_STARTED")
  bankReference String?
  bankLast4 String?
  bankVerificationStatus String @default("NOT_STARTED")
  profileFingerprint String?
  creationState String @default("NOT_STARTED")
  bankSubmissionFingerprint String?
  providerEnvironment String?
  requirements Json?
  verifiedAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  organisation PgOrganisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
}

model PgAudit {
  id String @id @default(cuid())
  actorAccountId String?
  organisationId String?
  action String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([organisationId, createdAt])
  @@index([actorAccountId, createdAt])
}

model Room {
  id         String   @id @default(cuid())
  propertyId String
  number     String
  capacity   Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([propertyId, number])
  @@index([propertyId, active])
}

model Student {
  id                   String        @id @default(cuid())
  propertyId           String
  userId               String        @unique
  roomId               String?
  mobile               String
  bedLabel             String?
  joiningDate          DateTime
  monthlyRentPaise     Int
  securityDepositPaise Int           @default(0)
  rentDueDay           Int           @default(5)
  status               StudentStatus @default(ACTIVE)
  notes                String?
  leftAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  room            Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  invoices        RentInvoice[]
  paymentAttempts PaymentAttempt[]
  payments        Payment[]
  rentRevisions   RentRevision[]

  @@unique([propertyId, mobile])
  @@index([propertyId, status])
  @@index([roomId])
}

model RentRevision {
  id             String   @id @default(cuid())
  propertyId     String
  studentId      String
  amountPaise    Int
  effectiveYear  Int
  effectiveMonth Int
  reason         String?
  createdByUserId String?
  createdAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, effectiveYear, effectiveMonth])
  @@index([propertyId, effectiveYear, effectiveMonth])
  @@index([studentId, effectiveYear, effectiveMonth])
}

model RentInvoice {
  id                    String        @id @default(cuid())
  propertyId            String
  studentId             String
  year                   Int
  month                  Int
  dueDate                DateTime
  rentPaise              Int
  electricityPaise       Int           @default(0)
  lateFeePaise           Int           @default(0)
  otherChargesPaise      Int           @default(0)
  discountPaise          Int           @default(0)
  totalPaise             Int
  paidPaise              Int           @default(0)
  status                 InvoiceStatus @default(DUE)
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentAttempts PaymentAttempt[]
  payments        Payment[]

  @@unique([studentId, year, month])
  @@index([propertyId, year, month])
  @@index([propertyId, status])
}

model PaymentAttempt {
  id                  String               @id @default(cuid())
  invoiceId           String
  studentId           String
  provider            String               @default("RAZORPAY")
  providerOrderId     String               @unique
  routeAccountId      String?
  providerPaymentId   String?              @unique
  amountPaise         Int
  status              PaymentAttemptStatus @default(CREATED)
  signatureVerifiedAt DateTime?
  failureCode         String?
  failureDescription  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  invoice RentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  propertyId        String
  studentId         String
  invoiceId         String
  amountPaise       Int
  source            PaymentSource
  method            PaymentMethod?
  providerOrderId   String?
  providerPaymentId String?       @unique
  receiptNumber     String        @unique
  paidAt            DateTime
  metadata          Json?
  createdAt         DateTime      @default(now())

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  student  Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice  RentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([propertyId, paidAt])
  @@index([studentId, paidAt])
  @@index([invoiceId])
}


model DeviceRegistration {
  id             String   @id @default(cuid())
  userId         String
  installationId String   @unique
  platform       String   @default("ANDROID")
  appVersion     String?
  enabled        Boolean  @default(true)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model NotificationCampaign {
  id                 String   @id @default(cuid())
  propertyId         String
  createdByUserId    String
  title              String
  body               String
  audienceType       String
  selectedStudentIds Json?
  financialYear      Int?
  financialMonth     Int?
  scheduleType       String
  scheduleTimes      Json
  startDate          String
  endDate            String
  timezone           String
  status             String   @default("ACTIVE")
  nextRunAt          DateTime?
  lastRunAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property   Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([propertyId, status, nextRunAt])
  @@index([createdByUserId, createdAt])
}

model NotificationDelivery {
  id                String   @id @default(cuid())
  campaignId        String
  userId            String
  installationId    String
  occurrenceKey     String
  status            String
  providerMessageId String?
  errorCode         String?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  campaign NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, installationId, occurrenceKey])
  @@index([campaignId, status])
  @@index([userId, sentAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  propertyId  String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  actor    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
}
