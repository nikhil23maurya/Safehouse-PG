NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://prisma.PROJECT_REF:YOUR_DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret

APP_NAME=SafeHouse
CORS_ORIGINS=*

# Used only to create the first owner/property automatically.
# Keep these for the first deploy, verify login, then remove BOOTSTRAP_OWNER_PASSWORD.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=ChangeThisImmediately123!
BOOTSTRAP_OWNER_NAME=Raj Sharma
BOOTSTRAP_PROPERTY_NAME=SafeHouse PG
